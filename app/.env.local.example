# ═════════════════════════════════════════════════════════
# Klary — Variables d'environnement locales
# ═════════════════════════════════════════════════════════
# Copiez ce fichier en `.env.local` et remplissez les valeurs.
# Ne JAMAIS commiter le vrai .env.local (déjà gitignored).

# ─── Supabase ───
# Récupérez depuis Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://ezhgsurhnyszhjixybak.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service role key — UNIQUEMENT côté serveur (Edge Functions, API routes)
# NE JAMAIS l'exposer côté client
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── Resend (envoi email) ───
# Récupérez depuis https://resend.com/api-keys
RESEND_API_KEY=re_XXXXXXXXXXXXXXXXX
RESEND_FROM_EMAIL=noreply@klary.ch
RESEND_ADMIN_CC=admin@klary.ch

# ─── Google Calendar (OAuth) ───
# À créer dans https://console.cloud.google.com → APIs & Services → Credentials
# Redirect URI à autoriser : {NEXT_PUBLIC_APP_URL}/api/google/callback
GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxx
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback
# En prod : GOOGLE_REDIRECT_URI=https://app.klary.ch/api/google/callback

# ─── Application ───
NEXT_PUBLIC_APP_URL=http://localhost:3000
# En prod : NEXT_PUBLIC_APP_URL=https://app.klary.ch

# ─── Sécurité ───
# Générer avec : openssl rand -base64 32
JWT_SECRET=CHANGEMOI

# ─── Environnement ───
NODE_ENV=development
